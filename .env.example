# ─── rapiDSK Enterprise API ───────────────────────────────────────────
# Single backend untuk frontend.
# Spec: docs/rapidsk_full_openapi_enterprise_spec.md
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: Enable debug mode for API requests
# VITE_API_DEBUG=true


# ─── Keycloak / IAM (single sign-on) ──────────────────────────────────
# Local Keycloak via Docker: lihat docker/keycloak/README.md
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=spektrum
VITE_KEYCLOAK_CLIENT_ID=rapidsk-web
