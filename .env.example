# ============================================================================
# Front-End (Vite)
# Salin ke `.env` lalu sesuaikan.
# Variabel `VITE_*` dibaca saat build, jadi ubah sebelum `npm run build`.
# ============================================================================

# Backend utama per-service fallback
# Dev lokal  : kosongkan bila mau lewat Vite proxy
# Dev server : isi bila ingin build langsung ke host live tanpa wrapper runtime
VITE_API_BASE_URL=
VITE_AUTH_BASE_URL=
VITE_CTS_BASE_URL=
VITE_CONNECTOR_BASE_URL=
VITE_MONITORING_BASE_URL=

# Proxy CTS untuk mode `npm run dev`
VITE_PROXY_TARGET=http://192.168.1.55:8581

# Proxy adapter untuk mode `npm run dev`
VITE_ADAPTER_TARGET=http://192.168.1.55:8584

# Fallback adapter endpoint bila wrapper runtime belum aktif
VITE_ADAPTER_ENDPOINT=http://192.168.1.55:8584

# Port dev server FE
VITE_DEV_PORT=8282

# Node geospasial tambahan bila masih dipakai di flow tertentu
VITE_NODE_BASE_URL=http://localhost:8000

# Optional debug request API
# VITE_API_DEBUG=true

# Optional SSO / Keycloak
# VITE_KEYCLOAK_URL=
# VITE_KEYCLOAK_REALM=
# VITE_KEYCLOAK_CLIENT_ID=

# ============================================================================
# Bundle server / wrapper runtime
# Variabel ini dibaca saat `server/bootstrap.cjs` dijalankan.
# Tidak perlu rebuild FE untuk mengubahnya.
# ============================================================================

RAPIDSK_PORT=8282
RAPIDSK_HOST=0.0.0.0

# Optional license validation server
# RAPIDSK_LICENSE_SERVER_URL=

# Optional nama proses PM2 / container
PM2_APP_NAME=rapidsk-fe
