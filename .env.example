# ============================================================================
#  Front-End (Vite) — environment
#  SALIN ke `.env` lalu sesuaikan:  cp .env.example .env
#  PENTING: variabel VITE_* di-"bake" saat `npm run build`. Set nilai yang benar
#  SEBELUM build di server. Mengubah .env setelah build TIDAK berpengaruh.
# ============================================================================

# URL API Backend GX-Space (fabric) — endpoint /api/v1.
# Dev lokal:   http://localhost:8184/api/v1
# Dev server:  http://<HOST-BE>:8184/api/v1   atau   https://<domain-BE>/api/v1
VITE_API_BASE_URL=http://localhost:8184/api/v1

# Node geospasial (OGC) — untuk fase upload/publish lanjutan.
VITE_NODE_BASE_URL=http://localhost:8000

# Optional: debug request API
# VITE_API_DEBUG=true

# ─── Keycloak / SSO (NONAKTIF) ───────────────────────────────────────
# Biarkan kosong → FE memakai login username/password (LOCAL JWT GX-Space).
# VITE_KEYCLOAK_URL=
# VITE_KEYCLOAK_REALM=
# VITE_KEYCLOAK_CLIENT_ID=
