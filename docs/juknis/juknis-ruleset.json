      "sigi_full_fields_pending": ["PROVINSI_2", "FASE_WK", "JENIS_WK", "LUAS_WK_AWAL", "LUAS_WK", "STATUS_PERUBAHAN", "NAMA_CEKUNGAN", "STATUS_CEKUNGAN", "DEPTH_RIGHTS", "PARTICIPATING_INTEREST", "KEWENANGAN", "ATTACHMENT", "REMARKS"],
