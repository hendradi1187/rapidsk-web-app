        { "name": "status_wk", "type": "string", "masked_l3": false, "description": "Status WK", "juknis_ref": "SIGI Tabel 2" },
        { "name": "provinsi_1", "type": "string", "masked_l3": false, "description": "Provinsi utama", "juknis_ref": "SIGI Tabel 2" },
        { "name": "lokasi", "type": "string", "masked_l3": false, "description": "Onshore/Offshore (OFFSHORE_IND)", "juknis_ref": "SIGI Tabel 2" },
