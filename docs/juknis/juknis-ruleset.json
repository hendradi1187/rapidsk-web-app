      "sigi_full_fields_pending": ["SUB_TIPE_MODEL: PIPELINE_LN", "PLATFORM_PT", "PLATFORM_AR", "FLOATING_FACILITY_PT", "CUSTODY_TRANSFER_METERING_PT", "KILANG_AR", "STORAGE_TANK_PT", "CABLE_LN", "OTHER_FACILITIES_PT"],
      "masking_rules": { "applies_when_classification_at_least": "L3", "coordinate_decimals_l3": 2, "coordinate_decimals_l4": 1, "masked_attributes": [] },
